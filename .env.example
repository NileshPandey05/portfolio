# Last.fm read-only public credentials for live "Listening now / Last played" status
# 1. Connect Spotify -> Last.fm in Last.fm Account Settings (Track My Music)
# 2. Create a free API key at https://www.last.fm/api/account/create
BUN_PUBLIC_LASTFM_USERNAME=
BUN_PUBLIC_LASTFM_API_KEY=

# Optional: CounterAPI v2 workspace/counter for global visitor count in footer
BUN_PUBLIC_COUNTER_WORKSPACE=
BUN_PUBLIC_COUNTER_NAME=portfolio
